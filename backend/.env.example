# Copy to backend/.env and fill in the keys. .env is git-ignored: never commit a real key.

# Postgres. Railway sets this; postgres:// and postgresql:// URLs both work.
DATABASE_URL=postgresql://countertalk:countertalk@127.0.0.1:5432/countertalk
# Audio, chunks and transcription replies. A relative path is inside backend/; Railway uses /data.
DATA_DIR=data
# The built web app. A relative path is inside backend/; the Docker image sets its own.
WEB_DIST_DIR=../web/dist
# 1 turns on development-only extras. Always 0 in production.
DEBUG=0
# One Meta key for both Muse Voice Transcribe and Muse Spark.
MODEL_API_KEY=
# Signs sign-in sessions. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Optional, for a dev tool only: scripts/make_test_audio.py makes test recordings with Sarvam's
# text-to-speech. The app never reads it.
SARVAM_API_KEY=
